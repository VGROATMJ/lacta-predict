# Salin ke .env lalu isi. JANGAN commit file .env.

# --- Supabase (wajib) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pakai SERVICE ROLE key (Project Settings > API). Hanya untuk backend, JANGAN dimasukkan ke aplikasi/frontend.
SUPABASE_KEY=eyJ...service_role_key...

# --- Keamanan API ---
FIREBASE_PROJECT_ID=lacta-predict
# true = endpoint /predict wajib token login Firebase milik pemilik sapi (disarankan).
REQUIRE_AUTH=true
# Token rahasia untuk endpoint admin (/predict/all, reset semua data). Kosong = fitur admin nonaktif.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Daftar origin yang boleh memanggil API, pisah koma. Produksi: isi domain app Anda.
ALLOWED_ORIGINS=*

# --- Opsional ---
PORT=8000
# Format kolom predictions.peringatan_dini: bool (true/false) atau text ("Waspada..."/"Normal")
PERINGATAN_FORMAT=bool
# Timpa ambang peringatan dini hasil training (pecahan, mis. 0.05 = prediksi turun >=5%). Kosong = dari model.
ALERT_THRESHOLD=
